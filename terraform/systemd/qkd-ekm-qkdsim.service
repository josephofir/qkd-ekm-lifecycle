[Unit]
Description=ETSI GS QKD 014 simulator (SAEs QKD1 and QKD2)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=/etc/qkd-ekm/env
ExecStart=/opt/qkd-ekm/venv/bin/qkd-ekm-qkdsim
WorkingDirectory=/var/lib/qkd-ekm
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
